{
  "name": "@anishfyi/troy",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "A browser an agent can actually read: DOM for structure, OCR for the pixels the DOM cannot explain.",
  "main": "src/browser/main.js",
  "author": "Anish Kumar <anishfyi@gmail.com>",
  "scripts": {
    "detect": "node scripts/detect.mjs",
    "fill": "node scripts/fill.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "browser": "electron src/browser/main.js",
    "icons": "node scripts/icons.mjs",
    "smoke": "node scripts/smoke-packaged.mjs",
    "stress": "node scripts/stress.mjs",
    "voice:prepare": "node scripts/prepare-whisper.mjs",
    "ocr:prepare": "node scripts/prepare-vision.mjs",
    "native:prepare": "npm run voice:prepare && npm run ocr:prepare",
    "clean": "node -e \"require('node:fs').rmSync('release',{recursive:true,force:true})\"",
    "pack": "node scripts/package-target.mjs --dir",
    "dist:mac": "node scripts/package-target.mjs --mac",
    "dist:win": "node scripts/package-target.mjs --win",
    "dist": "node -e \"throw new Error('Use dist:mac or dist:win on the target operating system')\""
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anishfyi/troy.git"
  },
  "homepage": "https://anishfyi.com/troy",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "playwright": "^1.62.0",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
